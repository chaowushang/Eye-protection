// ==UserScript==
// @name         微信读书网页版空格翻页
// @namespace    https://github.com/chaowushang/wechat-read-space-flip
// @version      1.0
// @author       wushang
// @description  在微信读书网页版阅读时，可以通过按下空格键跳到下一页。
// @match        *://weread.qq.com/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    /**
     * 核心逻辑说明：
     * 1. 微信读书原生支持“右方向键”翻页。
     * 2. 脚本拦截空格键，将其转换为“右方向键”信号发送给系统。
     * 3. 自动排除输入框焦点，防止打字时误翻页。
     */

    const init = () => {
        window.addEventListener('keydown', (e) => {
            // 检查按键是否为空格键
            if (e.key === ' ' || e.code === 'Space') {
                const activeEl = document.activeElement;

                // 安全检查：如果焦点在以下区域，则允许正常输入空格，不触发翻页
                // 1. 输入框 (INPUT)
                // 2. 文本域 (TEXTAREA)
                // 3. 可编辑的 HTML 元素 (contenteditable="true"，如微信读书的笔记输入区)
                const isTyping = activeEl.tagName === 'INPUT' || 
                                 activeEl.tagName === 'TEXTAREA' || 
                                 activeEl.isContentEditable;

                if (!isTyping) {
                    // 1. 阻止浏览器默认行为（即空格导致的页面向下滚动）
                    e.preventDefault();
                    // 2. 阻止事件继续传播（防止微信读书原生逻辑干扰）
                    e.stopImmediatePropagation();

                    // 3. 构造并派发一个“向右箭头”的按键事件
                    const nextEvent = new KeyboardEvent('keydown', {
                        key: 'ArrowRight',
                        keyCode: 39,
                        code: 'ArrowRight',
                        which: 39,
                        bubbles: true,
                        cancelable: true
                    });

                    // 同时发送给 window 和 document 确保微信读书的状态机能捕获到
                    window.dispatchEvent(nextEvent);
                    document.dispatchEvent(nextEvent);
                }
            }
        }, true); // 使用捕获阶段 (true) 拦截，确保优先级最高
    };

    // 启动监听
    init();

    console.log('微信读书空格翻页脚本已加载');
})();
